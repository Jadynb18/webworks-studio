
body {
  background-color: #f3f5ef;
  font-family: Arial, sans-serif;
  color: #2f3e35;
  padding-top: 30px;
}

.container {
  background-color: white;
  padding: 25px;
  border-radius: 12px;
  margin-bottom: 20px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
}

h2 {
  color: #315c3d;
  font-weight: bold;
}

h3 {
  color: #315c3d;
  font-weight: bold;
}

p {
  font-size: 16px;
  line-height: 1.6;
}

.btn-primary {
  background-color: #315c3d;
  border-color: #315c3d;
}

.btn-primary:hover {
  background-color: #264a30;
  border-color: #264a30;
}

.dropdown-menu {
  border-radius: 8px;
  border: 1px solid #d7dfd5;
  padding: 5px;
}

.dropdown-menu li a {
  color: #315c3d;
  padding: 10px 15px;
}

.dropdown-menu li a:hover {
  background-color: #e8eee6;
  color: #264a30;
}

.btn-group {
  margin-top: 20px;
}

.btn-group .btn {
  padding: 10px 18px;
}

@media (max-width: 767px) {
  body {
    padding-top: 15px;
  }

  .container {
    padding: 18px;
  }

  .btn-group {
    display: flex;
    flex-direction: column;
  }

  .btn-group .btn {
    width: 100%;
    margin-bottom: 5px;
  }
}

